# Copy this file to .env and fill in real values.

# Required : used by src/proof_generator.py to generate proofs, and as the reflection LM for GEPA in src/optimizers.py.
GEMINI_API_KEY=

# Required - used as the task LM the judges run on (NVIDIA NIM inference).
NVIDIA_API_KEY=

# Optional overrides - sensible defaults are set in code if omitted.
GENERATOR_MODEL=gemini-2.5-flash
TASK_MODEL=openai/meta/llama-3.1-70b-instruct
REFLECTION_MODEL=gemini/gemini-2.5-flash

# Which optimizer run_pipeline.py / optimizers.py uses by default: "gepa" or "bootstrap".
OPTIMIZER_METHOD=gepa
